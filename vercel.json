{
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 * * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/telegram/webhook",
      "headers": {
        "Cache-Control": "public, s-maxage=0, stale-while-revalidate=0"
      }
    },
    {
      "src": "/api/telegram/broadcast",
      "headers": {
        "Cache-Control": "public, s-maxage=0, stale-while-revalidate=0"
      }
    },
    {
      "src": "/api/cron/(.*)",
      "headers": {
        "Cache-Control": "public, s-maxage=0, stale-while-revalidate=0"
      }
    }
  ]
}
